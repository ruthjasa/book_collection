<%= form_with(model: user_book) do |form| %>
  <% if user_book.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(user_book.errors.count, "error") %> prohibited this user_book from being saved:</h2>
      <ul>
        <% user_book.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :user_id, "User" %><br>
    <%= form.select :user_id, User.order(:username).map { |user| [user.username, user.id] }, { include_blank: true }, id: "id_of_the_user_id_select_box" %>
  </div>

  <div>
    <%= form.label :book_id, "Book" %><br>
    <%= form.select :book_id, Book.order(:title).map { |book| [book.title, book.id] }, { include_blank: true }, id: "id_of_the_book_id_select_box" %>
  </div>

  <br>
  <div>
    <%= form.submit %>
  </div>
<% end %>