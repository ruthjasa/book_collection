<h1>Update Book</h1>

<% if @book && @book.errors.any? %>
    <div id="error_explanation">
        <h2><%= pluralize(@book.errors.count, "error") %> prohibited this book from being saved:</h2>
        <ul>
            <% @book.errors.full_messages.each do |msg| %>
                <li><%= msg %></li>
            <% end %>
        </ul>
    </div>
<% end %>

<%= form_with(model: @book, local: true) do |f| %>
    <div>
        <%= f.label :title %>
        <%= f.text_field :title %>
    </div>

    <div>
        <%= f.label :author %><br>
        <%= f.text_field :author %>
    </div>

    <div>
        <%= f.label :price %><br>
        <%= f.text_field :price %>
    </div>

    <div>
        <%= f.label :published_date, "Published Date" %><br>
        <%= f.date_select :published_date, start_year: 1900, end_year: Date.today.year %>
    </div>

    <br>
    <%= f.submit("Update Book") %>
<% end %>

<br>
<%= link_to("Back to Home Page", books_path) %>