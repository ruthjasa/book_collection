<h1>Delete Book Confirmation</h1>

<p>Are you sure you want to permanently delete this book?</p>
<p><strong>Title:</strong> <%= @book.title %></p>

<%= form_with(model: @book, url: book_path(@book), method: :delete) do |f| %>
    <%= f.submit("Delete Book") %>
<% end %>

<br>
<%= link_to("Back to Home Page", books_path) %>
