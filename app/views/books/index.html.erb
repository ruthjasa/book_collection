<h1>Book Collections</h1>

<%= link_to("Add New Book", new_book_path, class:'action new') %>

<table>
    <thead>
        <tr>
            <th>Title</th>
            <th>Actions</th>
        </tr>
    </thread>
    <tbody>
        <% @books.each do |book| %>
            <tr>
                <td><%= book.title %></td>
                <td>
                    <%= link_to("Show", book_path(book)) %> |
                    <%= link_to("Edit", edit_book_path(book)) %> |
                    <%= link_to("Delete", delete_book_path(book)) %>
                </td>
            </tr>
        <% end %>
    </tbody>
</table>

